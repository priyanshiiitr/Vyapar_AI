# Copy to backend/.env and fill in values. Never commit real secrets.

# --- Required for AI teammate ---
SARVAM_API_KEY=
SARVAM_CHAT_MODEL=sarvam-105b
SARVAM_TIMEOUT_SECONDS=60
SARVAM_MAX_TOKENS=4096

# --- Database (SQLite by default; optional Postgres URL) ---
DATABASE_URL=sqlite:///./data/vyapar.db

# --- App ---
APP_ENV=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DEMO_MERCHANT_ID=demo-merchant

# --- Inngest (optional; local DB scheduler used if unset) ---
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
INNGEST_DEV=1

# --- Langfuse (optional; structured local logs if unset) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
